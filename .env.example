# Copy this file, rename the copy to  .env  and paste your real key(s).
# .env is listed in .gitignore, so your keys never go to GitHub.

GEMINI_API_KEY=paste_your_gemini_key_here
GROQ_API_KEY=paste_your_groq_key_here

# Only for --provider custom (e.g. an API Kuku gives you in the interview)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
